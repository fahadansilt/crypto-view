{
  "name": "LuxAlgo-style trend signals (long/short)",
  "indicators": {
    "lux": {
      "id": "custom:luxalgo-style",
      "params": { "atrLength": 10, "sensitivity": 3, "trendFilter": "On", "emaLength": 50 }
    }
  },
  "entryLong": [{ "left": "lux.buy", "op": ">", "right": 0 }],
  "exitLong": [{ "left": "lux.direction", "op": "<", "right": 0 }],
  "entryShort": [{ "left": "lux.sell", "op": ">", "right": 0 }],
  "exitShort": [{ "left": "lux.direction", "op": ">", "right": 0 }],
  "initialCapital": 10000,
  "positionPct": 100,
  "feePct": 0.1,
  "slippagePct": 0.05
}
